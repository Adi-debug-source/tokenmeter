{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(python3 tests/*)",
      "Bash(python3 tokenmeter.py*)",
      "Bash(python3 statusline.py*)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f ~/.claude/hooks/test-gate.py || exit 0; python3 ~/.claude/hooks/test-gate.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
