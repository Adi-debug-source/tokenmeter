<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.adi-debug-source.tokenmeter</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Applications/Tokenmeter.app/Contents/MacOS/Tokenmeter</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <!--
    Errors go to the user's own Logs folder, which survives a reboot and is
    not shared: /tmp is shared by every account on the Mac, so a file or a
    symlink another account left there would be written to as this one.
    install-login-item.sh makes the folder before loading this.
  -->
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/Tokenmeter/tokenmeter.err</string>
</dict>
</plist>
